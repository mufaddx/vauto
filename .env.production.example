# Production secrets — never reuse staging credentials.

APP_ENV=production
APP_URL=https://app.vidlix.in
MARKETING_URL=https://vidlix.in
APP_HOST=app.vidlix.in
ADMIN_HOST=admin.vidlix.in
STAGING_HOST=staging.vidlix.in

# Supabase Postgres — pooler for app, direct for migrations
DATABASE_URL=
DIRECT_URL=
REDIS_URL=
SESSION_SECRET=

META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_LOGIN_APP_ID=
FACEBOOK_LOGIN_APP_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=auto

PUBLIC_SUPPORT_EMAIL=support@vidlix.in
PUBLIC_GRIEVANCE_EMAIL=
PUBLIC_GRIEVANCE_OFFICER=
PUBLIC_LEGAL_ENTITY=
PUBLIC_REGISTERED_OFFICE=
PUBLIC_GSTIN=
PUBLIC_CIN=
PUBLIC_PHONE=

# Encrypts Meta page access tokens at rest. 32 bytes, hex or base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Transactional email (password reset). Without these, reset links are logged only.
RESEND_API_KEY=
MAIL_FROM=VIDLIX <no-reply@vidlix.in>

# Worker
WORKER_CONCURRENCY=5

# Optional: verify the database TLS certificate chain. Without it the
# connection is still encrypted but the chain is not verified.
DATABASE_CA_CERT=

# Facebook login scopes. Business-type Meta apps cannot use email/public_profile.
FACEBOOK_LOGIN_SCOPES=email,public_profile
