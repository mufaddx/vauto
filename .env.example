# Copy to .env.local for development. Never commit real secrets.

APP_ENV=development
APP_URL=http://localhost:3000
MARKETING_URL=http://localhost:3000
APP_HOST=app.localhost
ADMIN_HOST=admin.localhost
STAGING_HOST=staging.localhost

DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
REDIS_URL=redis://localhost:6379

SESSION_SECRET=replace-with-32-plus-character-secret
SESSION_COOKIE_NAME=vidlix_session

# Meta (official Graph API only). Leave empty until you have a Meta app.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0

# Razorpay — server-side only
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google login (official OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook login for VIDLIX accounts (official Facebook Login).
# Falls back to META_APP_ID / META_APP_SECRET if these are empty.
FACEBOOK_LOGIN_APP_ID=
FACEBOOK_LOGIN_APP_SECRET=

# S3-compatible storage
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=auto

# Public placeholders until legal entity is confirmed
PUBLIC_SUPPORT_EMAIL=support@vidlix.in
PUBLIC_GRIEVANCE_EMAIL=
PUBLIC_GRIEVANCE_OFFICER=
PUBLIC_LEGAL_ENTITY=
PUBLIC_REGISTERED_OFFICE=
PUBLIC_GSTIN=
PUBLIC_CIN=
PUBLIC_PHONE=

# Encrypts Meta page access tokens at rest. 32 bytes, hex or base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Transactional email (password reset). Without these, reset links are logged only.
RESEND_API_KEY=
MAIL_FROM=VIDLIX <no-reply@vidlix.in>

# Worker
WORKER_CONCURRENCY=5

# Database TLS. Set the provider's CA certificate to verify the chain
# (Supabase: Project Settings -> Database -> SSL Configuration).
# Without it the app refuses to connect unless DATABASE_TLS_INSECURE=true,
# which encrypts the connection but does not verify the certificate.
DATABASE_CA_CERT=
DATABASE_TLS_INSECURE=

# Facebook login scopes. Business-type Meta apps cannot use email/public_profile.
FACEBOOK_LOGIN_SCOPES=email,public_profile
